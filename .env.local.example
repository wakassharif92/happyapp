# Supabase (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stable production domain (no trailing slash) — used ONLY for the
# per-project Customer Support / Internal Team shareable links
# (app/projects/[projectId]/links/page.tsx), since those get copied out
# and shared externally and need to stay durable across deploys. Leave
# unset for local dev (falls back to the request's own Host header). Do
# NOT use this for OAuth redirect URIs (Slack, Google) — those
# deliberately stay request-derived (lib/slack/requestOrigin.ts,
# lib/auth/publicOrigin.ts) since they must match whatever origin the
# flow actually ran on, not a fixed alias.
NEXT_PUBLIC_APP_URL=https://qa-agent-liart.vercel.app

# REQ-107: one API key per provider, routed per task by lib/agents/modelRouting.ts (REQ-104/106)
ANTHROPIC_API_KEY=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

QWEN_API_KEY=
# Best-effort default (international DashScope endpoint) — confirm the exact
# model id + region against your DashScope console; see modelRouting.ts.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Optional per-task overrides (REQ-106) — format "provider:model", one env var
# per task key in lib/agents/modelRouting.ts. Uncomment to override a default:
# MODEL_ROUTING_MODULE_SYNC=deepseek:deepseek-v4-flash
# MODEL_ROUTING_TEST_CASE_GENERATION=deepseek:deepseek-v4-flash
# MODEL_ROUTING_TEST_RUN=deepseek:deepseek-v4-pro
# MODEL_ROUTING_ISSUE_TRIAGE=anthropic:claude-sonnet-5
# MODEL_ROUTING_FIX_RUN=qwen:qwen3-coder-plus

# Automation bridges (Section 8) — local Node services, not deployed with the app
PLAYWRIGHT_BRIDGE_URL=http://localhost:4001
PLAYWRIGHT_BRIDGE_PORT=4001

# APPIUM_BRIDGE_PORT is the mobile bridge's own listen port — set the
# project's automation_target (Project Settings) to http://localhost:<this
# port>. APPIUM_SERVER_URL is the real Appium server the bridge connects
# OUT to (start it yourself: `npx appium --port 4723`, needs ANDROID_HOME +
# JAVA_HOME set and a device/emulator visible to `adb devices`).
APPIUM_BRIDGE_PORT=4002
APPIUM_SERVER_URL=http://localhost:4723

# Desired capabilities (REQ-091) — global for now, not per-project (known
# gap, see PROGRESS.md): only one mobile project's app can be targeted at a
# time. APPIUM_DEVICE_NAME is cosmetic when exactly one device/emulator is
# attached; appPackage/appActivity are optional — omit both to attach to
# whatever's already in the foreground instead of auto-launching an app.
APPIUM_DEVICE_NAME=
APPIUM_APP_PACKAGE=
APPIUM_APP_ACTIVITY=

# WhatsApp report inbox (Section 11, REQ-110–115) — from your Meta app
# (developers.facebook.com): access token, phone number id, and app secret.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN is any string you pick yourself, used only
# for the one-time webhook verification handshake. Meta needs a public
# HTTPS URL to call — during local dev, tunnel your dev server (e.g.
# `ngrok http <port>`) and point the webhook config at the tunnel URL.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Slack integration (qa-agent-spec.md Section 13, REQ-126–131) — see
# docs/slack-setup.md for the full Slack App configuration walkthrough
# (scopes, OAuth redirect URL, Event Subscriptions URL). From your Slack
# App's "Basic Information" and "OAuth & Permissions" pages.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# No separate "app base URL" env var — the OAuth redirect_uri is derived
# from the incoming request's own Host header (same pattern app/reports/
# page.tsx uses for its shareable link), so it's always correct for
# whatever URL you're actually running behind, local tunnel included, with
# nothing to go stale after an ngrok restart.

# Random 32-byte key, base64-encoded, used to encrypt Slack bot tokens at
# rest (lib/slack/tokenCrypto.ts). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Do NOT reuse the same key across environments; losing this key makes
# every stored Slack token permanently undecryptable (that project just
# needs to be reconnected through OAuth again — nothing else is affected).
SLACK_TOKEN_ENCRYPTION_KEY=
